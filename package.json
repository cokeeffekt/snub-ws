{
  "name": "snub-ws",
  "version": "5.1.0",
  "description": "WebSocket server middleware for snub",
  "main": "snub-ws.js",
  "types": "index.d.ts",
  "bin": {
    "snub-ws-prune": "scripts/prune-uws.js"
  },
  "scripts": {
    "test": "jest --runInBand --forceExit",
    "redis": "docker run --rm --name redis-snub -d -p 6379:6379 redis:4.0-alpine",
    "debug": "npx pm2 del all; npx pm2 start examples/websocket-server.js -i 4 && npx pm2 restart all && npx pm2 logs",
    "prune-uws": "node scripts/prune-uws.js",
    "publish": "npm publish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cokeeffekt/snub-ws.git"
  },
  "keywords": [
    "redis",
    "websocket"
  ],
  "author": "Patrik Hartwig",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/cokeeffekt/snub-ws/issues"
  },
  "homepage": "https://github.com/cokeeffekt/snub-ws#readme",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "uws-legacy": "github:uNetworking/uWebSockets.js#v20.51.0",
    "uws-modern": "github:uNetworking/uWebSockets.js#v20.69.0"
  },
  "devDependencies": {
    "ioredis-mock": "^8.13.1",
    "jest": "^29.7.0",
    "prettier": "^2.3.1",
    "snub": "latest",
    "ws": "^8.12.1"
  }
}
